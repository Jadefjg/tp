# 复制为 .env 后按需修改。docker compose 会自动读取同目录 .env

# 应用
TP_DEBUG=false
TP_PORT=18081
TP_WORKERS=1
TP_RUNNER_PER_WORKER=20
TP_HOST=localhost:9528
TP_GENERATE_SCHEMAS=true
TP_INIT_DEBUG_DATA=false
TP_ADMIN_USER=admin
TP_ADMIN_PASSWORD=admin123

# MySQL
MYSQL_ROOT_PASSWORD=testplatform
MYSQL_DATABASE=testplatform
MYSQL_USER=testplatform
MYSQL_PASSWORD=testplatform
